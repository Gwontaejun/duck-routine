{
  "expo": {
    "name": "Duck Routine",
    "slug": "duck-routine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "duckroutine",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#FF7A24",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.gwontaejun.duckroutine",
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "package": "com.gwontaejun.duckroutine",
      "versionCode": 5,
      "icon": "./assets/images/app-icon.png",
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 112
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7A24",
          "defaultChannel": "routine-reminders"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6204548244998320~1637785769",
          "iosAppId": "ca-app-pub-6204548244998320~5964043584"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light"
      },
      "eas": {
        "projectId": "ac8fd1d7-f9b9-4771-a8b7-6efa91e6ee9a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ac8fd1d7-f9b9-4771-a8b7-6efa91e6ee9a"
    }
  }
}
